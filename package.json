{
  "name": "@warlockcode/agent-viewer",
  "version": "0.5.0",
  "description": "Open-source visual observability for AI agents in an interactive animated virtual office, with a one-command CLI and a Claude Code adapter",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmmana/Agent-Viewer.git"
  },
  "homepage": "https://github.com/jmmana/Agent-Viewer#readme",
  "bugs": {
    "url": "https://github.com/jmmana/Agent-Viewer/issues"
  },
  "keywords": [
    "ai-agents",
    "agent-observability",
    "multi-agent",
    "llm",
    "react",
    "canvas",
    "visualization",
    "virtual-office",
    "claude-code",
    "cli"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "bin": {
    "agent-viewer": "./dist-cli/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist-lib/lib/index.d.ts",
      "import": "./dist-lib/lib/index.js"
    },
    "./style.css": "./dist-lib/agent-viewer.css",
    "./package.json": "./package.json"
  },
  "module": "./dist-lib/lib/index.js",
  "types": "./dist-lib/lib/index.d.ts",
  "files": [
    "dist-lib",
    "dist-cli",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:lib": "vite build --mode lib && tsc -p src/lib/tsconfig.json && node scripts/fix-dts-extensions.mjs dist-lib && node -e \"require('node:fs').copyFileSync('src/lib/agent-viewer.css','dist-lib/agent-viewer.css')\"",
    "build:cli": "node scripts/build-cli.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-lib dist-cli server.js",
    "lint": "tsc --noEmit",
    "test": "npm run test:node && npm run test:unit",
    "test:node": "tsx --test tests/*.test.mjs",
    "test:unit": "vitest run",
    "test:golden": "tsx --test tests/reconciliation.test.mjs",
    "check:package": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints ./style.css",
    "prepack": "npm run build:lib && npm run build:cli",
    "server": "tsx server/index.ts",
    "dev:full": "node scripts/dev-full.mjs",
    "test:e2e": "playwright test",
    "crew:capture": "node scripts/capture-crew-runtime.mjs",
    "crew:assets:check": "node scripts/crew-assets.mjs check",
    "crew:assets:import": "node scripts/crew-assets.mjs import",
    "crew:perf:bench": "tsx scripts/crew-perf-benchmark.mjs",
    "crew:perf:browser": "node scripts/crew-perf-browser.mjs",
    "crew:palette:measure": "node scripts/crew-palette-measure.mjs",
    "cli": "tsx cli/index.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^1.52.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^18.0.5",
    "jsdom": "^29.1.1",
    "publint": "^0.3.25",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "warn"
    }
  },
  "author": "Juan Manuel Castillo (https://github.com/jmmana)",
  "contributors": [
    "María Alejandra (https://github.com/Alejagop12)"
  ]
}
