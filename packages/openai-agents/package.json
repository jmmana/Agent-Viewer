{
  "name": "@warlockcode/agent-viewer-openai-agents",
  "version": "0.6.0",
  "description": "OpenAI Agents SDK tracing-processor adapter for Agent Viewer: plugs into @openai/agents's own tracing pipeline so every agent run, handoff, tool call and model generation is captured automatically.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmmana/Agent-Viewer.git",
    "directory": "packages/openai-agents"
  },
  "homepage": "https://github.com/jmmana/Agent-Viewer/tree/main/packages/openai-agents#readme",
  "bugs": {
    "url": "https://github.com/jmmana/Agent-Viewer/issues"
  },
  "keywords": [
    "ai-agents",
    "agent-observability",
    "openai-agents",
    "tracing",
    "telemetry",
    "sdk"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "check:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "peerDependencies": {
    "@openai/agents": "^0.20.0"
  },
  "dependencies": {
    "@warlockcode/agent-viewer-sdk": ">=0.6.0"
  },
  "devDependencies": {
    "@openai/agents": "^0.20.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "author": "Juan Manuel Castillo (https://github.com/jmmana)",
  "contributors": [
    "María Alejandra (https://github.com/Alejagop12)"
  ]
}
