# Agent Viewer Ingestion Server Port (default: 8787)
PORT=8787

# Optional Bearer token to protect /api/v1 ingestion endpoints
# Empty means the API is open: the server warns at startup. Generate a token with: openssl rand -base64 32
AGENT_VIEWER_API_TOKEN=

# Allowed CORS origin(s) for browser clients (comma-separated or * for all)
AGENT_VIEWER_CORS_ORIGIN=http://localhost:3000

# Persistence storage engine: 'memory' or 'sqlite' (default: memory)
AGENT_VIEWER_STORAGE=memory

# Cap on the retained event window in memory mode (default: 10000). Dedup of accepted event ids is never capped,
# only the list GET /api/v1/events and SSE replay can see. In sqlite mode this only caps the in-memory fallback
# used for totals, never the stored rows. Must be a positive integer; an invalid value stops the server at startup.
# AGENT_VIEWER_MAX_EVENTS=10000

# Path to SQLite database file when AGENT_VIEWER_STORAGE=sqlite
AGENT_VIEWER_SQLITE_PATH=./data/agent-viewer.db

# Back up existing databases before automatic schema migrations ('auto' or 'off')
AGENT_VIEWER_SQLITE_BACKUP=auto

# Rows replayed per page of the SQLite startup rebuild (default: 2000)
AGENT_VIEWER_REBUILD_PAGE_SIZE=2000

# Extra delay (ms) awaited after each startup rebuild page, for tests and diagnostics (default: 0)
AGENT_VIEWER_REBUILD_PAGE_DELAY_MS=0

# Maximum events accepted in a single POST /api/v1/events/batch request
AGENT_VIEWER_MAX_BATCH_SIZE=100

# Maximum requests allowed per minute per IP for /api/v1 endpoints
AGENT_VIEWER_RATE_LIMIT=1000

# Secret key for HMAC-SHA256 signature verification on /api/v1/webhooks/generic
# If empty, webhook signature verification is skipped
AGENT_VIEWER_WEBHOOK_SECRET=

# Retention (see docs/retention.md). Both windows are unset by default: nothing is ever deleted and no purge
# timer is started. A window is an integer number of days, 1 to 36500; 0, negative, decimal or out-of-range
# values refuse to start the server, naming the variable and the accepted range.
# AGENT_VIEWER_RETENTION_DAYS=30
# Independent of the events window above; defaults to keep forever (the usage ledger is the audit record of
# tokens and cost, and normally should outlive the raw event stream).
# AGENT_VIEWER_USAGE_RETENTION_DAYS=
# How often the purge job runs once either window above is set (default: 60). Integer, 1 to 1440.
# AGENT_VIEWER_RETENTION_INTERVAL_MINUTES=60

# Frontend API URL (injected by Vite in browser)
VITE_AGENT_VIEWER_API_URL=http://localhost:8787
