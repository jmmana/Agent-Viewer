# Agent Viewer Ingestion Server Port (default: 8787)
PORT=8787

# Optional Bearer token to protect /api/v1 ingestion endpoints
# Empty means the API is open: the server warns at startup. Generate a token with: openssl rand -base64 32
AGENT_VIEWER_API_TOKEN=

# Allowed CORS origin(s) for browser clients (comma-separated or * for all)
AGENT_VIEWER_CORS_ORIGIN=http://localhost:3000

# Persistence storage engine: 'memory' or 'sqlite' (default: memory)
AGENT_VIEWER_STORAGE=memory

# Path to SQLite database file when AGENT_VIEWER_STORAGE=sqlite
AGENT_VIEWER_SQLITE_PATH=./data/agent-viewer.db

# Back up existing databases before automatic schema migrations ('auto' or 'off')
AGENT_VIEWER_SQLITE_BACKUP=auto

# Maximum events accepted in a single POST /api/v1/events/batch request
AGENT_VIEWER_MAX_BATCH_SIZE=100

# Maximum requests allowed per minute per IP for /api/v1 endpoints
AGENT_VIEWER_RATE_LIMIT=1000

# Secret key for HMAC-SHA256 signature verification on /api/v1/webhooks/generic
# If empty, webhook signature verification is skipped
AGENT_VIEWER_WEBHOOK_SECRET=

# Frontend API URL (injected by Vite in browser)
VITE_AGENT_VIEWER_API_URL=http://localhost:8787
