# Agent Viewer Ingestion Server Port (default: 8787)
PORT=8787

# Interface the server binds (default: 127.0.0.1, loopback only). A non-loopback value with no
# AGENT_VIEWER_API_TOKEN refuses to start; set a token first, or AGENT_VIEWER_ALLOW_OPEN=1 to accept an open API.
# AGENT_VIEWER_HOST=127.0.0.1

# Set to 1 to let the server bind a non-loopback interface with no token anyway (see AGENT_VIEWER_HOST above),
# and to silence the open-mode request guard. Any other value is ignored.
# AGENT_VIEWER_ALLOW_OPEN=

# Optional Bearer token to protect /api/v1 ingestion endpoints
# Empty means the API is open: the server warns at startup. Generate a token with: openssl rand -base64 32
AGENT_VIEWER_API_TOKEN=

# Allowed CORS origin(s) for browser clients (comma-separated or * for all)
AGENT_VIEWER_CORS_ORIGIN=http://localhost:3000

# Persistence storage engine: 'memory' or 'sqlite' (default: memory)
AGENT_VIEWER_STORAGE=memory

# Cap on the retained event window in memory mode (default: 10000). Dedup of accepted event ids is never capped,
# only the list GET /api/v1/events and SSE replay can see. In sqlite mode this only caps the in-memory fallback
# used for totals, never the stored rows. Must be a positive integer; an invalid value stops the server at startup.
# AGENT_VIEWER_MAX_EVENTS=10000

# Path to SQLite database file when AGENT_VIEWER_STORAGE=sqlite
AGENT_VIEWER_SQLITE_PATH=./data/agent-viewer.db

# Back up existing databases before automatic schema migrations ('auto' or 'off')
AGENT_VIEWER_SQLITE_BACKUP=auto

# Rows replayed per page of the SQLite startup rebuild (default: 2000)
AGENT_VIEWER_REBUILD_PAGE_SIZE=2000

# Extra delay (ms) awaited after each startup rebuild page, for tests and diagnostics (default: 0)
AGENT_VIEWER_REBUILD_PAGE_DELAY_MS=0

# Maximum events accepted in a single POST /api/v1/events/batch request
AGENT_VIEWER_MAX_BATCH_SIZE=100

# Maximum requests allowed per minute per IP for /api/v1 endpoints
AGENT_VIEWER_RATE_LIMIT=1000

# Maximum missed events a reconnecting SSE client replays in full (default: 10000). 0 means any reconnect that
# missed something resyncs instead of replaying. An invalid value stops the server at startup.
# AGENT_VIEWER_SSE_REPLAY_MAX=10000

# Above this many matching rows, GET /api/v1/usage/export answers 422 export_too_large before streaming
# anything (default: 1000000). See docs/usage-export.md.
# AGENT_VIEWER_EXPORT_MAX_ROWS=1000000

# Concurrent GET /api/v1/usage/export requests this process serves at once (default: 2); above it, 429
# export_busy. Does not apply to /usage/export/totals.
# AGENT_VIEWER_EXPORT_CONCURRENCY=2

# Secret key for HMAC-SHA256 signature verification on /api/v1/webhooks/generic
# If empty, webhook signature verification is skipped
AGENT_VIEWER_WEBHOOK_SECRET=

# Outbound budget alert webhook (issue #86, sub-issue #321). Delivers every `budget.alert` event (a budget
# crossing its warning or critical threshold), signed with its own HMAC secret, never AGENT_VIEWER_WEBHOOK_SECRET
# above. With the URL unset (the default), the feature is off and nothing is ever sent.
# AGENT_VIEWER_ALERT_WEBHOOK_URL=https://hooks.example.com/agent-viewer-budget-alerts
# Separate from AGENT_VIEWER_WEBHOOK_SECRET; empty sends deliveries unsigned.
AGENT_VIEWER_ALERT_WEBHOOK_SECRET=
# Set to 1 to allow a plain http:// destination on a non-loopback host. Loopback is always allowed.
AGENT_VIEWER_ALERT_WEBHOOK_ALLOW_HTTP=
# Total delivery attempts (1 initial plus retries) before a delivery is left failed for good. 1 to 20 (default: 6)
AGENT_VIEWER_ALERT_WEBHOOK_MAX_ATTEMPTS=6
# Per-attempt HTTP timeout in milliseconds. 500 to 60000 (default: 5000)
AGENT_VIEWER_ALERT_WEBHOOK_TIMEOUT_MS=5000

# Retention (see docs/retention.md). Both windows are unset by default: nothing is ever deleted and no purge
# timer is started. A window is an integer number of days, 1 to 36500; 0, negative, decimal or out-of-range
# values refuse to start the server, naming the variable and the accepted range.
# AGENT_VIEWER_RETENTION_DAYS=30
# Independent of the events window above; defaults to keep forever (the usage ledger is the audit record of
# tokens and cost, and normally should outlive the raw event stream).
# AGENT_VIEWER_USAGE_RETENTION_DAYS=
# How often the purge job runs once either window above is set (default: 60). Integer, 1 to 1440.
# AGENT_VIEWER_RETENTION_INTERVAL_MINUTES=60

# Pricing table (see docs/pricing.md). The operator-editable current table and its append-only version
# history. Default: pricing.json and pricing-history.jsonl next to AGENT_VIEWER_SQLITE_PATH (./data by
# default). The CLI defaults AGENT_VIEWER_PRICING_FILE to a file under AGENT_VIEWER_HOME instead.
# AGENT_VIEWER_PRICING_FILE=./data/pricing.json
# AGENT_VIEWER_PRICING_HISTORY_FILE=./data/pricing-history.jsonl
# Set to 1 to disable POST /api/v1/pricing/changes (file-only management). Reload stays available.
# AGENT_VIEWER_PRICING_READONLY=1
# Hard cap on matched rows for one POST /api/v1/pricing/recompute run (default: 200000); above it,
# 413 filter_too_broad before anything is written. See docs/pricing.md.
# AGENT_VIEWER_RECOMPUTE_MAX_ROWS=200000

# Frontend API URL (injected by Vite in browser)
VITE_AGENT_VIEWER_API_URL=http://localhost:8787
